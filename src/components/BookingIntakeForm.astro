---
---
<section class="section intake-section" id="intake"><div class="section-wrap intake-layout">
  <div class="intake-copy reveal"><p class="eyebrow">DIAGNOSTIC INTAKE / 05</p><h2>描述你的需求，<br /><em>從第一筆紀錄開始。</em></h2><p>填寫設備異常或零件委製資訊，系統會整理成詢問摘要。送出前可複製內容，透過電話或 LINE 與工作室聯繫確認。</p><div class="intake-aside"><span class="mono">NOTICE / 001</span><p>此表單目前為前端需求整理工具，不會自動傳送資料。請複製摘要後透過電話或 LINE 聯繫。</p></div></div>
  <form class="intake-form reveal" id="intake-form" novalidate>
    <div class="form-head"><span>REQUEST FORM / LC—LAB</span><span class="mono">FORM—001</span></div>
    <label>服務類型 <select name="service" required><option value="">請選擇服務類型</option><option>電路板檢測維修</option><option>機械零件加工製作</option><option>機電總成零件洽詢</option></select></label>
    <label>設備型號或零件名稱 <input name="item" required placeholder="例如：工業控制板、襯套、門鎖支座" /></label>
    <fieldset><legend>異常現象／委製需求（可複選）</legend><div class="check-grid">{['不開機','無訊號輸出','元件燒毀','斷線／短路','斷裂／磨損','來樣／圖面訂製','急件處理','其他需求'].map(item => <label class="check-label"><input type="checkbox" name="issues" value={item} /><span>{item}</span></label>)}</div></fieldset>
    <label>需求描述 <textarea name="description" rows="3" placeholder="請描述故障情況、尺寸／材質需求、數量或其他資訊"></textarea></label>
    <label>交付方式 <select name="delivery" required><option value="">請選擇交付方式</option><option>工作室親送</option><option>預約時段</option><option>宅配寄送</option><option>先電話洽詢</option></select></label>
    <div class="form-two"><label>聯絡人 <input name="contact" required placeholder="姓名／稱呼" /></label><label>聯絡電話 <input name="phone" required inputmode="tel" placeholder="手機或市話" /></label></div>
    <label>LINE ID（選填） <input name="line" placeholder="方便聯繫的 LINE ID" /></label>
    <p class="form-error" id="form-error" role="alert"></p>
    <button class="button button-orange form-submit" type="submit">產生需求摘要 <span>↗</span></button>
    <div class="summary-panel" id="summary-panel" hidden><div class="summary-head"><b>INTAKE SUMMARY / 需求摘要</b><span class="mono" id="ticket-id"></span></div><pre id="summary-text"></pre><button class="button button-dark" type="button" id="copy-summary">複製摘要內容</button><p class="summary-hint">請將摘要內容複製後，透過電話或 LINE 與工作室確認。</p></div>
  </form>
</div></section>
<script>
const form = document.querySelector('#intake-form');
const error = document.querySelector('#form-error');
const panel = document.querySelector('#summary-panel');
const summary = document.querySelector('#summary-text');
let ticket = '';
form?.addEventListener('submit', (event) => {
  event.preventDefault(); error.textContent = ''; panel.hidden = true;
  if (!form.reportValidity()) { error.textContent = '請先填寫服務類型、設備／零件名稱、聯絡人、電話與交付方式。'; return; }
  const data = new FormData(form); const issues = data.getAll('issues');
  ticket = `LC-${new Date().toISOString().slice(2,10).replaceAll('-','')}-${Math.random().toString(36).slice(2,6).toUpperCase()}`;
  const content = [`需求單號：${ticket}`,`服務類型：${data.get('service')}`,`設備／零件：${data.get('item')}`,`異常／需求：${issues.length ? issues.join('、') : '未指定'}`,`補充描述：${data.get('description') || '無'}`,`交付方式：${data.get('delivery')}`,`聯絡人：${data.get('contact')}`,`電話：${data.get('phone')}`,`LINE：${data.get('line') || '未提供'}`,`備註：此摘要由網站前端產生，尚未送出至工作室。`].join('\n');
  summary.textContent = content; document.querySelector('#ticket-id').textContent = ticket; panel.hidden = false; panel.scrollIntoView({behavior:'smooth',block:'nearest'});
});
document.querySelector('#copy-summary')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(summary.textContent); document.querySelector('#copy-summary').textContent = '已複製 ✓'; } catch { error.textContent = '無法自動複製，請選取摘要文字手動複製。'; } });
</script>
