---
import { shopInfo } from '../data/shopInfo';
---
<section class="hero section-wrap" id="top">
  <div class="hero-copy reveal">
    <div class="eyebrow"><span class="eyebrow-line"></span> PRECISION DIAGNOSTIC OBSERVATORY <span class="mono">／ 01—06</span></div>
    <p class="hero-kicker">力丞實業有限公司 — 維修工作室</p>
    <h1>觀測電路與機構異常，<br /><em>維修還原</em>工業基準。</h1>
    <p class="hero-desc">專注工業電路板檢測維修與機械零件加工製作。從異常量測、故障定位到零件規格確認，以清楚的流程協助設備恢復可靠運作。</p>
    <div class="hero-ctas"><a class="button button-orange" href="#intake">線上報修／零件委製 <span>↗</span></a><a class="text-link" href={`tel:${shopInfo.tel}`}>撥打技術專線 <span>→</span></a></div>
    <div class="hero-meta"><span><b>PCB</b> CIRCUIT REPAIR</span><span><b>CNC</b> PARTS FABRICATION</span><span><b>01—04</b> INTAKE PROCESS</span></div>
  </div>
  <div class="hero-visual reveal" aria-label="電路與精密機械工程示意圖">
    <div class="visual-top"><span>FIG. 001 / DIAGNOSTIC FIELD</span><span>LC—LAB</span></div>
    <svg class="schematic" viewBox="0 0 620 500" role="img" aria-label="電路板走線與精密零件線稿示意">
      <defs><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#b9c1bf" opacity=".7" /></pattern></defs>
      <rect width="620" height="500" fill="url(#dots)" />
      <g fill="none" stroke="#82918e" stroke-width="1.2" opacity=".8"><path d="M30 112H170V165H245V220H340"/><path d="M50 350H155V300H220V260H290"/><path d="M410 55V120H480V185H560"/><path d="M370 400H460V340H540V280H590"/><path d="M80 70V150H120V210H180"/><path d="M470 420V370H420V315H370"/></g>
      <g fill="#d94e1f"><circle cx="170" cy="112" r="4"/><circle cx="245" cy="165" r="4"/><circle cx="155" cy="300" r="4"/><circle cx="480" cy="120" r="4"/><circle cx="460" cy="340" r="4"/></g>
      <g transform="translate(210 155)" fill="none" stroke="#d94e1f" stroke-width="1.5"><rect x="0" y="0" width="170" height="150" rx="2"/><rect x="20" y="20" width="130" height="110"/><path d="M-16 30H0M-16 60H0M-16 90H0M-16 120H0M170 30h16M170 60h16M170 90h16M170 120h16M35 -16v16M70 -16v16M105 -16v16M140 -16v16M35 150v16M70 150v16M105 150v16M140 150v16"/><path d="M50 55h70v40H50z" stroke="#82918e"/><circle cx="85" cy="75" r="18" stroke="#82918e"/><path d="M85 57v36M67 75h36" stroke="#82918e"/></g>
      <g transform="translate(430 190)" fill="none" stroke="#82918e" stroke-width="1.5"><path d="M0 0h115v35H0zM15 35v85h85V35M28 35v85M87 35v85M0 120h115"/><path d="M-15 -12h145M-15 -20v16M130 -20v16M-18 0v120M-26 0h16M-26 120h16" stroke="#d94e1f"/><circle cx="57" cy="77" r="18"/><circle cx="57" cy="77" r="6"/></g>
      <g fill="#525b65" font-family="JetBrains Mono, monospace" font-size="10"><text x="28" y="28">SIGNAL TRACE / A—01</text><text x="420" y="165">PART PROFILE / B—02</text><text x="30" y="470">OBSERVATION GRID  ·  0.00—1.00</text><text x="460" y="470">FIG. 001</text></g>
      <g stroke="#d94e1f" stroke-width="1" opacity=".6"><path d="M290 230L390 125H440"/><path d="M490 320L560 390H590"/></g>
    </svg>
    <div class="visual-caption"><span>PCB TRACE / MECHANICAL PROFILE</span><span class="pulse-label"><i></i> SYSTEM READY</span></div>
    <div class="telemetry"><div><small>LOCATION</small><strong>新北市・新莊區</strong></div><div><small>WORKING HOURS</small><strong>MON—FRI / 11:00—20:30</strong></div><div><small>TECH LINE</small><strong>02-2205-2128</strong></div></div>
  </div>
</section>
